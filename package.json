{
  "name": "reactive-bb-frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "test": "vitest --config ./vitest.config.ts",
    "test:coverage": "vitest --coverage",
    "compile": "graphql-codegen",
    "watch": "graphql-codegen -w",
    "build": "tsc && vite build",
    "lint": "eslint . --report-unused-disable-directives --max-warnings 0 -c .eslintrc.cjs",
    "preview": "vite preview",
    "postinstall": "husky install"
  },
  "dependencies": {
    "@ant-design/icons": "^6.3.4",
    "@apollo/client": "^4.3.1",
    "@fortawesome/fontawesome-svg-core": "^7.3.1",
    "@fortawesome/free-brands-svg-icons": "^7.3.1",
    "@fortawesome/free-regular-svg-icons": "^7.3.1",
    "@fortawesome/free-solid-svg-icons": "^7.3.1",
    "@fortawesome/react-fontawesome": "^3.5.0",
    "@graphql-typed-document-node/core": "^3.2.0",
    "antd": "^6.6.5",
    "apollo-upload-client": "^20.0.0",
    "date-fns": "^4.4.0",
    "emojibase-data": "^17.0.0",
    "eslint-plugin-react": "^7.37.5",
    "graphql": "^17.0.2",
    "graphql-ws": "^6.2.2",
    "i18next": "^26.4.2",
    "i18next-browser-languagedetector": "^8.2.1",
    "i18next-http-backend": "^4.0.2",
    "kalliope": "^0.17.0",
    "katex": "^0.18.7",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-helmet-async": "^3.0.0",
    "react-i18next": "^17.0.15",
    "react-responsive": "^10.0.1",
    "react-router": "^8.4.0",
    "react-router-dom": "^7.18.4",
    "rxjs": "^7.8.2",
    "zxcvbn": "^4.4.2"
  },
  "devDependencies": {
    "@graphql-codegen/cli": "^7.4.2",
    "@graphql-codegen/client-preset": "^6.2.0",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/katex": "^0.16.8",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/zxcvbn": "^4.4.5",
    "@typescript-eslint/eslint-plugin": "^8.70.1",
    "@typescript-eslint/parser": "^8.70.1",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "^5.0.1",
    "eslint": "^10.11.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "husky": "^9.1.7",
    "jsdom": "^30.1.1",
    "lint-staged": "^17.5.1",
    "prettier": "3.9.8",
    "typescript": "^6.0.3",
    "vite": "^8.3.0",
    "vitest": "^5.0.1"
  },
  "husky": {
    "hooks": {
      "pre-commit": "lint-staged"
    }
  },
  "lint-staged": {
    "*.{ts,tsx}": "eslint --cache --fix",
    "*.{ts,tsx,js,css,md}": [
      "prettier --write"
    ]
  },
  "resolutions": {
    "@rc-component/util": "^1.6.0"
  },
  "packageManager": "yarn@4.1.1"
}
